    {
      "endpoint": "/api/v1/order-summary/{order_id}",
      "method": "GET",
      "output_encoding": "json",
      "timeout": "2500ms",
      "input_headers": [
        "Authorization"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/orders/{order_id}",
          "group": "order_info",
          "encoding": "json",
          "target": "data",
          "deny": [
            "histories",
            "notes",
            "shipping"
          ],
          "host": [
            "http://order-service:3000"
          ]
        },
        {
          "url_pattern": "/api/v1/payments/invoices/order/{order_id}",
