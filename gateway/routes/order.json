          "encoding": "json",
          "target": "data",
          "host": [
            "http://payment-service:3000"
          ]
        },
        {
          "url_pattern": "/api/v1/logistics/order/{order_id}",
          "group": "delivery_info",
          "encoding": "json",
          "target": "data",
          "deny": [
            "tracking_logs",
            "proof"
          ],
