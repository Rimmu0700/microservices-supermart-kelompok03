{
  "$schema": "https://www.krakend.io/schema/v2.6/krakend.json",
  "version": 3,
  "name": "SuperMart API Gateway",
  "port": 8080,
  "timeout": "3000ms",
  "extra_config": {
    "security/cors": {
      "allow_origins": [
        "http://localhost:4200",
        "http://localhost:8000"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ],
      "allow_headers": [
        "Origin",
        "Authorization",
        "Content-Type",
        "Accept"
      ],
      "expose_headers": [
        "Content-Length",
        "X-Krakend-Completed"
      ],
      "max_age": "12h",
      "allow_credentials": false
    }
  }
}
